# Configuration Firebase (Optionnel pour le mode démo local, requis pour la production)
# Rendez-vous sur https://console.firebase.google.com/ pour créer un projet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Code PIN du panneau d'administration (par défaut 1234)
VITE_ADMIN_PIN=1234

# Date d'anniversaire au format ISO (AAAA-MM-JJTHH:mm:ss)
# Par défaut : 4 octobre 2026 à 12:00:00 (midi)
VITE_TARGET_DATE=2026-10-04T12:00:00
